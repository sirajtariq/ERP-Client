{
  "name": "lenden-app",
  "version": "1.0.0",
  "description": "LenDen - Desktop ERP & Khata Book Application",
  "author": "LenDen",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node_modules\\\\electron\\\\dist\\\\electron.exe .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "antd": "^5.22.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lenden.app",
    "productName": "LenDen ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../server/dist/ERP_Backend",
        "to": "ERP_Backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LenDen ERP",
      "uninstallDisplayName": "LenDen ERP Uninstaller",
      "deleteAppDataOnUninstall": true,
      "include": "electron/installer.nsh"
    }
  }
}
